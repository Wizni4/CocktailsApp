{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
        "src": [
            {
                "src": "../src",
                "files": [
                    "**/*.csproj"
                ]
            }
        ],
        "dest": "api",
        "namespaceLayout": "nested",
        "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
        {
            "files": "**/README.md",
            "src": "..",
            "dest": "introduction"
        },
        {
            "files": "**/LICENSE.md",
            "src": "..",
            "dest": "license"
        },
        {
            "files": [
                "**/*.{md,yml}"
            ],
            "exclude": [
                "_site/**"
            ]
        }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "CocktailsApp",
      "_appTitle": "CocktailsApp",
      "_enableSearch": true,
      "pdf": false
    }
  }
}