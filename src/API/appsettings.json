{
    "AllowedHosts": "*",
    "AWS": {
        "Region": "eu-west-3"
    },
    "Auth": {
        "Provider": "Cognito",
        "JwtBearer": {
            "Authority": "https://cognito-idp.eu-west-3.amazonaws.com/eu-west-3_pZzl4aPjV",
            "MetadataAddress": "https://cognito-idp.eu-west-3.amazonaws.com/eu-west-3_pZzl4aPjV/.well-known/openid-configuration",
            "IncludeErrorDetails": true,
            "RequireHttpsMetadata": true,
            "TokenValidationParameters": {
                "ValidateIssuer": true,
                "ValidIssuer": "https://cognito-idp.eu-west-3.amazonaws.com/eu-west-3_pZzl4aPjV",
                "ValidateAudience": false,
                "ValidateIssuerSigningKey": true
            }
        },
        "Local": {
            "Issuer": "CocktailsApp",
            "Audience": "CocktailsApp.Api"
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "SearchOptions": {
        "DefaultLimit": 10,
        "MaxLimit": 20,
        "UseFuzziness": true,
        "Fuzziness": "AUTO",
        "EnableHighlights": true,
        "SuggestLimit": 5
    },
    "PageOptions": {
        "DefaultLimit": 10,
        "MaxLimit": 20
    }
}
