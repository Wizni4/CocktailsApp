{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ClubSettings": {
        "MaxOwnedClubs": 3
    },
    "SearchOptions": {
        "DefaultLimit": 10,
        "MaxLimit": 20,
        "UseFuzziness": true,
        "Fuzziness": "AUTO",
        "EnableHighlights": true,
        "SuggestLimit": 5
    },
    "ImageSettings": {
        "RootPath": "wwwroot/images",
        "PublicBaseUrl": "http://localhost:5170/images"
    }
}
