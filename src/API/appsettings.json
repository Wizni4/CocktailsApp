{
    "AllowedHosts": "*",
    "AWS": {
        "Region": "eu-west-3"
    },
    "Auth": {
        "Provdier": "Cognito",
        "JwtBearer": {
            "Authority": "https://cognito-idp.eu-west-3.amazonaws.com/eu-west-3_pZzl4aPjV",
            "IncludeErrorDetails": false,
            "RequireHttpsMetadata": true,
            "MapInboundClaims": false,
            "TokenValidationParameters": {
                "ValidateIssuer": true,
                "ValidIssuer": "https://cognito-idp.eu-west-3.amazonaws.com/eu-west-3_pZzl4aPjV",
                "ValidateAudience": false,
                "ValidateIssuerSigningKey": true,
                "ValidateLifetime": true
            }
        },
        "Local": {
            "Issuer": "CocktailsApp",
            "Audience": "CocktailsApp.Api"
        }
    },
    "Cache": {
        "Provider": "Redis",
        "Redis": {
            "Configuration": "xxxxx.xxxxxx.ng.0001.euw3.cache.amazonaws.com:6379,ssl=True,abortConnect=false",
            "Instance": "xxxx:prod:"
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "SearchOptions": {
        "DefaultLimit": 10,
        "MaxLimit": 20,
        "UseFuzziness": true,
        "Fuzziness": "AUTO",
        "EnableHighlights": true,
        "SuggestLimit": 5
    },
    "PageOptions": {
        "DefaultLimit": 10,
        "MaxLimit": 20
    }
}
